# RepuTex Backend Environment Configuration
PROJECT_NAME="RepuTex Backend"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true

# Server
HOST="0.0.0.0"
PORT=8000
API_V1_PREFIX="/api/v1"
CORS_ORIGINS=["*"]

# Database (PostgreSQL with asyncpg, fallback SQLite for tests)
DATABASE_URL="postgresql+asyncpg://reputex:reputex_secret@localhost:5432/reputex_db"
DATABASE_URL_SYNC="postgresql://reputex:reputex_secret@localhost:5432/reputex_db"
# For local development without running Postgres:
# DATABASE_URL="sqlite+aiosqlite:///./reputex.db"
# DATABASE_URL_SYNC="sqlite:///./reputex.db"

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# JWT Security
JWT_SECRET="reputex-super-secret-key-change-in-production-2026-xyz"
JWT_ALGORITHM="HS256"
JWT_ACCESS_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=30

# External Integration Modes (mock | real)
PLATFORM_MODE="mock"
AI_PROVIDER="mock"
AI_API_KEY=""

# Platform API Credentials (optional in mock mode)
# Google Places API (New): Requires enabling "Places API (New)" in Google Cloud Console.
# When provided and PLATFORM_MODE="real", GoogleConnector executes Text Search to discover place_id
# and Place Details to acquire fresh reviews. If empty or PLATFORM_MODE="mock", falls back to MockPlatformConnector.
GOOGLE_PLACES_API_KEY=""
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="reputex-app:v1.0"
TWITTER_BEARER_TOKEN=""

# Firecrawl Web Acquisition (Primary for Reddit and X)
# Used to search and extract publicly accessible Reddit discussions and X posts.
# When provided and PLATFORM_MODE="real", RedditConnector and TwitterConnector use Firecrawl.
# If empty or FIRECRAWL_ENABLED=false, connectors fall back to mock or optional official APIs.
FIRECRAWL_API_KEY=""
FIRECRAWL_ENABLED=false
FIRECRAWL_BASE_URL="https://api.firecrawl.dev"
FIRECRAWL_MAX_RESULTS_PER_QUERY=5
FIRECRAWL_MAX_PAGES_PER_INGESTION=3

