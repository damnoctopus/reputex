# RepuTex Backend Environment Configuration
PROJECT_NAME="RepuTex Backend"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true

# Server
HOST="0.0.0.0"
PORT=8000
API_V1_PREFIX="/api/v1"
CORS_ORIGINS=["*"]

# Database
DATABASE_URL="sqlite+aiosqlite:///./reputex.db"
DATABASE_URL_SYNC="sqlite:///./reputex.db"
# Switch to PostgreSQL when PostgreSQL service is active:
# DATABASE_URL="postgresql+asyncpg://reputex:reputex_secret@localhost:5432/reputex_db"
# DATABASE_URL_SYNC="postgresql://reputex:reputex_secret@localhost:5432/reputex_db"

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# JWT Security
JWT_SECRET="reputex-super-secret-key-change-in-production-2026-xyz"
JWT_ALGORITHM="HS256"
JWT_ACCESS_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=30

# External Integration Modes (mock | real)
PLATFORM_MODE="mock"
AI_PROVIDER="mock"
AI_API_KEY=""

# Platform API Credentials
GOOGLE_PLACES_API_KEY=""
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="reputex-app:v1.0"
TWITTER_BEARER_TOKEN=""
