# App Configuration
APP_NAME=RepuTex Intelligence Backend
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["*"]

# Database
DATABASE_URL=sqlite+aiosqlite:///./reputex.db
SYNC_DATABASE_URL=sqlite:///./reputex.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/reputex
# SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reputex

# JWT Security
SECRET_KEY=reputex_super_secret_jwt_key_change_in_production_32bytes!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Gemini API Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_ENABLED=true
GEMINI_TIMEOUT_SECONDS=20.0
GEMINI_MAX_RETRIES=3

# Acquisition & Mock Mode
USE_MOCK_ACQUISITION=true
USE_MOCK_GEMINI=true

# Celery & Redis (Optional - default is in-process background execution)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
USE_CELERY=false
